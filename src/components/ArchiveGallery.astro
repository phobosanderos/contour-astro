---
import archiveData from "../content/archive.json";
import { imageDimensions } from "../lib/archive-image-dimensions";

const filters = ["all", "design", "motion", "illustration"];
const sources = ["all", "client", "personal"];
// Editorial flags stay in JSON but are excluded from client-side data.
const archive = archiveData.map(entry => ({
  ...entry,
  items: entry.items.map(item => ({...item, ...imageDimensions(item.type === "image" ? item.src : item.poster)})),
  coverDimensions: imageDimensions(entry.cover || entry.items.find(item => item.type === "image")?.src || entry.items.find(item => item.type === "video")?.poster),
}));
const first = item => item.items[0];
const imageFor = item => item.cover || first(item)?.poster || (first(item)?.type === "image" ? first(item).src : null);
---
<div class="work__archive" id="archive">
  <header class="section-head work__archive-head">
    <span class="note note--ink">THE ARCHIVE</span>
    <span class="note" data-archive-count>{archive.length} PROJECTS</span>
    <span class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-archive-count-live>{archive.length} PROJECTS</span>
  </header>

  <div class="archive-filters" aria-label="Archive filters">
    <div class="archive-source" role="group" aria-label="Show">
      {sources.map((source, i) => (
        <button type="button" class={`archive-filter archive-source__button note${i === 0 ? " is-active" : ""}`}
          data-archive-source={source} aria-pressed={i === 0 ? "true" : "false"}>{source}</button>
      ))}
    </div>
    <div class="archive-type-control">
      <label class="note" for="archive-type">Type</label>
      <span class="archive-type-wrap">
        <select id="archive-type" class="archive-type note" data-archive-type>
          {filters.map(type => <option value={type}>{type}</option>)}
        </select>
        <svg class="ui-icon" aria-hidden="true" focusable="false"><use href="/img/ui-icons.svg#arrow-down"></use></svg>
      </span>
      <button type="button" class="archive-clear note" data-archive-clear hidden>Clear</button>
    </div>
  </div>

  <div class="archive-gallery__grid">
    {archive.map((item, i) => (
      <button class="archive-gallery__card" type="button"
        data-archive-index={i} data-archive-category={item.category} data-archive-project-tag={item.tag}
        data-cursor="view" aria-label={`Open ${item.title}`}>
        <div class="archive-gallery__visual">
          {imageFor(item) ? (
            <img src={imageFor(item)} alt={item.alt} width={item.coverDimensions.width || 1} height={item.coverDimensions.height || 1}
              loading="lazy" decoding="async" />
          ) : (
            <video
  data-src={first(item)?.src}
  poster={first(item)?.poster}
  muted
  playsinline
  preload="none"
  aria-label={item.title}
  data-archive-thumbnail
/>
          )}
          {first(item)?.type === "video" && (
            <span class="archive-gallery__play" aria-hidden="true"><svg class="ui-icon" focusable="false"><use href="/img/ui-icons.svg#play"></use></svg></span>
          )}
        </div>
        <div class="archive-gallery__meta">
          <span class="archive-gallery__title note">
          {item.titleSegments ? item.titleSegments.map(segment => segment.strike
            ? <><s>{segment.text}</s><span class="sr-only"> (crossed out)</span></>
            : segment.text) : item.title}
          </span>
          {item.items.length > 1 && (
            <span class="archive-gallery__count note">{String(item.items.length).padStart(2, "0")} ITEMS</span>
          )}
        </div>
      </button>
    ))}
  </div>
  <div class="archive-gallery__empty note" data-archive-empty hidden>
    <span data-archive-empty-message>No matching work.</span>
    <button type="button" class="archive-clear" data-archive-empty-clear>Clear filters</button>
  </div>
</div>

<dialog class="project-lightbox archive-lightbox" data-archive-dialog role="dialog" aria-modal="true" aria-labelledby="archive-dialog-title">
  <div class="project-lightbox__window archive-lightbox__window" data-archive-window>
    <header class="project-lightbox__head">
      <div class="project-lightbox__identity note">
        <span data-archive-number></span><span data-archive-title id="archive-dialog-title"></span>
      </div>
      <div class="archive-lightbox__tools">
        <button type="button" class="info-dialog__close project-lightbox__close" data-archive-close
          aria-label="Close"><svg class="ui-icon" aria-hidden="true" focusable="false"><use href="/img/ui-icons.svg#close"></use></svg></button>
      </div>
    </header>
    <div class="project-lightbox__media archive-lightbox__media" data-archive-media tabindex="0"></div>
    <footer class="project-lightbox__nav archive-lightbox__nav" data-archive-nav hidden>
      <button class="project-lightbox__nav-button note" type="button" data-archive-prev><svg class="ui-icon" aria-hidden="true" focusable="false"><use href="/img/ui-icons.svg#arrow-left"></use></svg> Previous</button>
      <span class="project-lightbox__counter note" data-archive-counter></span>
      <button class="project-lightbox__nav-button note" type="button" data-archive-next>Next <svg class="ui-icon" aria-hidden="true" focusable="false"><use href="/img/ui-icons.svg#arrow-right"></use></svg></button>
    </footer>
  </div>
</dialog>

<script is:inline define:vars={{ archive }}>
(() => {
  const $ = (s, el = document) => el.querySelector(s);
  const $$ = (s, el = document) => [...el.querySelectorAll(s)];
  const dialog = $('[data-archive-dialog]');
  if (!(dialog instanceof HTMLDialogElement)) return;
  const windowEl = $('[data-archive-window]', dialog);
  const mediaEl = $('[data-archive-media]', dialog);
  const navEl = $('[data-archive-nav]', dialog);
  const counterEl = $('[data-archive-counter]', dialog);
  const prevEl = $('[data-archive-prev]', dialog);
  const nextEl = $('[data-archive-next]', dialog);
  const countEl = $('[data-archive-count]');
  const countLiveEl = $('[data-archive-count-live]');
  const typeSelect = $('[data-archive-type]');
  const clearButton = $('[data-archive-clear]');
  const emptyEl = $('[data-archive-empty]');
  const emptyMessage = $('[data-archive-empty-message]');
  const emptyClearButton = $('[data-archive-empty-clear]');
  let descriptionBar = null;
  let entryIndex = 0, itemIndex = 0, sequence = 0, lastTrigger = null;
  let touchStart = null;
  let nextImage = null;

  function preloadNextImage() {
    const next = archive[entryIndex]?.items?.[itemIndex + 1];
    nextImage = null;
    if (next?.type !== 'image' || !next.src) return;
    nextImage = new Image();
    nextImage.decoding = 'async';
    nextImage.src = next.src;
  }


  const grid = $('.archive-gallery__grid');
  const cards = $$("[data-archive-index]");
  let activeSource = "all", activeType = "all";
  const total = archive.length;
  let filterTimer = 0, filterVersion = 0;
  function updateGrid() {
    let visible = 0;
    cards.forEach(card => {
      const matches = (activeType === "all" || card.dataset.archiveCategory === activeType) &&
        (activeSource === "all" || card.dataset.archiveProjectTag === activeSource);
      card.hidden = !matches;
      if (matches) visible++;
    });
    const filtered = activeSource !== "all" || activeType !== "all";
    const text = filtered ? `${visible} OF ${total} PROJECTS` : `${total} PROJECTS`;
    countEl.textContent = text;
    countLiveEl.textContent = text;
    clearButton.hidden = !filtered;
    emptyEl.hidden = visible !== 0;
    if (!visible) {
      emptyMessage.textContent = activeSource !== "all" && activeType !== "all"
        ? `No ${activeSource} ${activeType} work yet.`
        : "No matching work.";
    }
  }
  function applyFilters() {
    clearTimeout(filterTimer);
    const version = ++filterVersion;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      updateGrid(); return;
    }
    grid.classList.add("is-filter-switching");
    filterTimer = window.setTimeout(() => {
      if (version !== filterVersion) return;
      const oldScroll = window.scrollY;
      updateGrid();
      window.scrollTo({top: oldScroll, behavior:"instant"});
      requestAnimationFrame(() => {
        if (version === filterVersion) grid.classList.remove("is-filter-switching");
      });
    }, 160);
  }
  function resetFilters() {
    activeSource = "all"; activeType = "all";
    typeSelect.value = "all";
    $$("[data-archive-source]").forEach(button => {
      const selected = button.dataset.archiveSource === "all";
      button.classList.toggle("is-active", selected);
      button.setAttribute("aria-pressed", String(selected));
    });
    applyFilters();
  }
  $$("[data-archive-source]").forEach(button => button.addEventListener("click", () => {
    activeSource = button.dataset.archiveSource;
    $$("[data-archive-source]").forEach(other => {
      const selected = button === other;
      other.classList.toggle("is-active", selected);
      other.setAttribute("aria-pressed", String(selected));
    });
    applyFilters();
  }));
  typeSelect.addEventListener("change", () => { activeType = typeSelect.value; applyFilters(); });
  clearButton.addEventListener("click", resetFilters);
  emptyClearButton.addEventListener("click", resetFilters);

  const thumbnailVideos = $$(
  "[data-archive-thumbnail]"
);

const thumbnailObserver =
  new IntersectionObserver(
    (entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        const video = entry.target;
        const src = video.dataset.src;

        if (!src) return;

        video.addEventListener(
          "loadedmetadata",
          () => {
            if (
              Number.isFinite(video.duration) &&
              video.duration > 0.1
            ) {
              try {
                video.currentTime = Math.min(
                  0.15,
                  video.duration / 2
                );
              } catch (_) {}
            }
          },
          { once: true }
        );

        video.src = src;
        video.preload = "metadata";

        observer.unobserve(video);
      });
    },
    {
      rootMargin: "300px 0px",
      threshold: 0
    }
  );

thumbnailVideos.forEach((video) => {
  thumbnailObserver.observe(video);
});
  function assetFor(item) {
    const asset = document.createElement(item.type === 'video' ? 'video' : 'img');
    asset.src = item.src;
    if (item.type === 'video') {
      asset.controls = true;
      asset.controlsList = 'nodownload';
      asset.playsInline = true;
      asset.preload = 'metadata';
      if (item.poster) asset.poster = item.poster;
    } else {
      asset.alt = item.alt;
      if (item.width && item.height) { asset.width = item.width; asset.height = item.height; }
      asset.decoding = 'async';
    }
    return asset;
  }

  /* Resize the already loaded asset in place; retain video playback and
     the current item when device orientation or the visual viewport changes. */
  function fitVisibleAsset(asset) {
    if (!dialog.open || !asset) return;
    const w = asset.tagName === 'VIDEO' ? asset.videoWidth : asset.naturalWidth;
    const h = asset.tagName === 'VIDEO' ? asset.videoHeight : asset.naturalHeight;
    if (!(w > 0 && h > 0)) return;
    const chromeHeight =
      $('.project-lightbox__head', windowEl).offsetHeight +
      (navEl.hidden ? 0 : navEl.offsetHeight) +
      (descriptionBar?.offsetHeight || 0);
    const vw = window.visualViewport?.width || innerWidth;
    const vh = window.visualViewport?.height || innerHeight;
    const maxW = Math.max(80, vw - 64);
    const maxH = Math.max(80, vh - 64 - chromeHeight);
    const scale = Math.min(1, maxW / w, maxH / h);
    const rw = Math.max(1, Math.floor(w * scale));
    const rh = Math.max(1, Math.floor(h * scale));
    asset.style.width = rw + 'px';
    asset.style.height = rh + 'px';
    windowEl.style.width = Math.max(1, Math.min(vw - 24, rw + 32)) + 'px';
    mediaEl.style.height = Math.ceil(rh + 32) + 'px';
  }
  let resizeFrame = 0;
  const requestRefit = () => {
    if (!dialog.open) return;
    cancelAnimationFrame(resizeFrame);
    resizeFrame = requestAnimationFrame(() => fitVisibleAsset($('img,video', mediaEl)));
  };
  window.addEventListener('resize', requestRefit, {passive:true});
  window.visualViewport?.addEventListener('resize', requestRefit, {passive:true});

  function render() {
    const entry = archive[entryIndex];
    const item = entry?.items?.[itemIndex];
    if (!item) return;
    const ticket = ++sequence;
    const count = entry.items.length;
    navEl.hidden = count <= 1;
    prevEl.hidden = itemIndex === 0;
    nextEl.hidden = itemIndex === count - 1;
    const position = `${itemIndex + 1} / ${count}`;
    counterEl.textContent = count > 1 ? position : '';
    $('[data-archive-number]', dialog).textContent = count > 1 ? position : '';
    preloadNextImage();
    const asset = assetFor(item);

    const apply = () => {
      if (ticket !== sequence || !dialog.open) return;
      const w = asset.tagName === 'VIDEO' ? asset.videoWidth : asset.naturalWidth;
      const h = asset.tagName === 'VIDEO' ? asset.videoHeight : asset.naturalHeight;
      if (!(w > 0 && h > 0)) return;

      mediaEl.classList.add('is-switching');
      window.setTimeout(() => {
        if (ticket !== sequence || !dialog.open) return;
        $('video', mediaEl)?.pause();
        fitVisibleAsset(asset);
        /* Swap the asset while the previous one is faded out */
mediaEl.replaceChildren(asset);

/* Skip the image fade for reduced-motion visitors. */
const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
asset.style.opacity = reducedMotion ? '1' : '0';
requestAnimationFrame(() => {
  mediaEl.classList.remove('is-switching');
  const show = () => {
    asset.style.opacity = '1';
  };
  if (reducedMotion) show();
  else requestAnimationFrame(show);
});
      }, matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 150);
    };
    const loadError = () => {
      if (ticket !== sequence || !dialog.open) return;
      mediaEl.classList.remove('is-switching');
      mediaEl.style.height = '';
      windowEl.style.width = Math.min(innerWidth - 24, 420) + 'px';
      const message = document.createElement('div');
      message.className = 'project-lightbox__load-error note';
      message.setAttribute('role', 'status');
      const label = document.createElement('span');
      label.textContent = 'This asset could not be loaded.';
      const retry = document.createElement('button');
      retry.type = 'button';
      retry.className = 'archive-clear note';
      retry.textContent = 'Retry';
      retry.addEventListener('click', () => render());
      message.append(label, retry);
      mediaEl.replaceChildren(message);
    };
    asset.addEventListener('error', loadError, {once:true});
    if (asset.tagName === 'VIDEO') {
      if (asset.readyState >= 1) apply();
      else asset.addEventListener('loadedmetadata', apply, { once: true });
    } else if (asset.complete && asset.naturalWidth) apply();
    else if (asset.complete && !asset.naturalWidth) loadError();
    else asset.addEventListener('load', apply, { once: true });
  }

  function writeDescription(entry) {
    descriptionBar?.remove();
    descriptionBar = null;
    dialog.removeAttribute("aria-describedby");
    const description = entry.notes || "";
    if (!description) return;
    const bar = document.createElement("footer");
    bar.className = "info-dialog__foot archive-lightbox__description";
    bar.id = "archive-dialog-description";
    bar.setAttribute("role", "region");
    bar.setAttribute("aria-label", "About this work");
    const paragraph = document.createElement("p");
    paragraph.className = "note";
    // Only text nodes and validated, explicit link data are inserted.
    const link = entry.link;
    const allowed = link?.url && /^(https?:|mailto:)/i.test(link.url);
    if (!allowed || !description.includes(link.text)) {
      paragraph.textContent = description;
    } else {
      const at = description.indexOf(link.text);
      paragraph.append(document.createTextNode(description.slice(0, at)));
      const anchor = document.createElement("a");
      anchor.href = link.url;
      anchor.textContent = link.text;
      if (/^https?:/i.test(link.url)) {
        anchor.target = "_blank";
        anchor.rel = "noopener noreferrer";
        const notice = document.createElement("span");
        notice.className = "sr-only";
        notice.textContent = " (opens in a new tab)";
        anchor.append(notice);
      }
      paragraph.append(anchor, document.createTextNode(description.slice(at + link.text.length)));
    }
    bar.append(paragraph);
    windowEl.append(bar);
    dialog.setAttribute("aria-describedby", bar.id);
    descriptionBar = bar;
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      bar.classList.add("is-entering");
      requestAnimationFrame(() => bar.classList.remove("is-entering"));
    }
  }

  function open(index, trigger) {
    entryIndex = index; itemIndex = 0; lastTrigger = trigger;
    const entry = archive[index];
    if (!entry?.items?.length) return;

    const heading = $('[data-archive-title]', dialog);
    heading.replaceChildren();
    if (entry.titleSegments?.length) {
      entry.titleSegments.forEach(segment => {
        if (!segment.strike) { heading.append(document.createTextNode(segment.text)); return; }
        const strike = document.createElement('s'); strike.textContent = segment.text;
        const explanation = document.createElement('span');
        explanation.className = 'sr-only'; explanation.textContent = ' (crossed out)';
        heading.append(strike, explanation);
      });
    } else heading.textContent = entry.title;
    writeDescription(entry);
    windowEl.style.width = '';
    mediaEl.style.height = '';
    window.__lenis?.stop?.();
    dialog.showModal();
    render();
    requestAnimationFrame(() => mediaEl.focus({preventScroll:true}));
  }
  $$("[data-archive-index]").forEach(card => card.addEventListener('click', () => open(Number(card.dataset.archiveIndex), card)));
  $('[data-archive-close]',dialog).addEventListener('click', () => dialog.close());
  nextEl.addEventListener('click', () => { if (itemIndex < archive[entryIndex].items.length - 1) { itemIndex++; render(); } });
  prevEl.addEventListener('click', () => { if (itemIndex > 0) { itemIndex--; render(); } });
  dialog.addEventListener('close', () => {
    sequence++;
    touchStart = null;
    nextImage = null;
    $('[data-archive-number]', dialog).textContent = '';
    $('[data-archive-title]', dialog).textContent = '';
    counterEl.textContent = '';
    $('video', mediaEl)?.pause();
    mediaEl.replaceChildren();
    mediaEl.style.height = '';
    descriptionBar?.remove();
    descriptionBar = null;
    dialog.removeAttribute("aria-describedby");
    window.__lenis?.start?.();
    lastTrigger?.focus({preventScroll:true});
  });
  dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('keydown', e => {
    if (!dialog.open) return;
    if (e.key === 'Escape') { e.preventDefault(); dialog.close(); return; }
    if (e.key === 'ArrowRight' && itemIndex < archive[entryIndex].items.length - 1) { e.preventDefault(); itemIndex++; render(); }
    if (e.key === 'ArrowLeft' && itemIndex > 0) { e.preventDefault(); itemIndex--; render(); }
  });

  mediaEl.addEventListener('touchstart', e => {
    if (!dialog.open || e.touches.length !== 1) return;
    touchStart = { x: e.touches[0].clientX, y: e.touches[0].clientY };
  }, { passive: true });

  mediaEl.addEventListener('touchend', e => {
    if (!dialog.open || !touchStart || !e.changedTouches.length) return;
    const dx = e.changedTouches[0].clientX - touchStart.x;
    const dy = e.changedTouches[0].clientY - touchStart.y;
    touchStart = null;
    if (Math.abs(dx) < 55 || Math.abs(dx) < Math.abs(dy) * 1.3) return;
    const count = archive[entryIndex]?.items?.length || 0;
    if (dx < 0 && itemIndex < count - 1) { itemIndex++; render(); }
    if (dx > 0 && itemIndex > 0) { itemIndex--; render(); }
  }, { passive: true });
})();
</script>
