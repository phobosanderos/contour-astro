---
import work from "../content/work.json";

const featured = work.featured;
const archive = work.archive || [];

const archiveFilters = [
  "all",
  "visuals",
  "motion",
  "campaigns",
  "identity"
];

const stripYear = (title = "") => {
  const parts = title.trim().split(" ");
  const lastPart = parts[parts.length - 1];

  const isYear =
    lastPart?.length === 4 &&
    !Number.isNaN(Number(lastPart));

  return isYear
    ? parts.slice(0, -1).join(" ")
    : title;
};
---
<section
  class="section wrap work"
  id="work"
  aria-labelledby="work-heading"
>
  <h2 class="sr-only" id="work-heading">Work</h2>

  <header class="section-head work__head">
    <span class="note note--ink">Work</span>
    <span class="note">Featured projects</span>
  </header>

  <div class="featured-projects">
    {
      featured.map((project, index) => (
        <a
          class={`featured-card featured-card--${index + 1}`}
          href={`/work/${project.slug}/`}
          data-reveal="up"
          data-cursor="open →"
          aria-label={`View ${project.title}`}
        >
          <div class="featured-card__media">
            <img
              class="featured-card__image"
              src={project.primaryImage}
              alt={project.alt}
              style={`object-position:${project.coverPosition || "center center"};`}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
            />

            <span
              class="featured-card__number note"
              aria-hidden="true"
            >
              {project.number}
            </span>
          </div>

          <div class="featured-card__info">

  <div class="featured-card__title-row">
    <h3 class="h3 featured-card__title">
      {stripYear(project.title)}
    </h3>

    <span class="featured-card__year note">
      {project.year}
    </span>
  </div>

  <div class="featured-card__body">
    <p class="featured-card__description">
      {project.description}
    </p>
  </div>

  <div class="featured-card__action" aria-hidden="true">
    <span class="note featured-card__view">
      View project
    </span>

    <span class="featured-card__arrow">
      ↗
    </span>
  </div>

</div>
        </a>
      ))
    }
  </div>

  <div
  class="work__archive"
  id="archive"
>
  <header class="section-head work__archive-head">
    <span class="note note--ink">
      THE ARCHIVE
    </span>

    <span class="note">
      {archive.length
        ? `${String(archive.length).padStart(2, "0")} projects`
        : "More work"}
    </span>
  </header>


  {
    archive.length > 0 && (
      <>
        <div
          class="archive-filters"
          aria-label="Filter archive"
        >
          {
            archiveFilters.map((filter, index) => (
              <button
                class={`archive-filter note${index === 0 ? " is-active" : ""}`}
                type="button"
                data-archive-filter={filter}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                {filter}
              </button>
            ))
          }
        </div>


        <div class="archive-grid">
          {
            archive.map((project) => (
              <a
                class="archive-card"
                href={`/work/${project.slug}/`}
                data-archive-item
                data-archive-category={project.category?.toLowerCase()}
                data-cursor="open →"
              >
                <div class="archive-card__media">
                  <img
                    class="archive-card__image"
                    src={project.primaryImage}
                    alt={project.alt || ""}
                    loading="lazy"
                    decoding="async"
                  />
                </div>

                <div class="archive-card__meta">
                  <div class="archive-card__title-row">
                    <h3 class="archive-card__title">
                      {project.title}
                    </h3>

                    <span class="note archive-card__year">
                      {project.year}
                    </span>
                  </div>

                  <span class="note archive-card__category">
                    {project.category}
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </>
    )
  }
</div>
</section>
<script is:inline>
  (() => {
    const filters =
      document.querySelectorAll(
        "[data-archive-filter]"
      );

    const items =
      document.querySelectorAll(
        "[data-archive-item]"
      );


    if (!filters.length || !items.length) {
      return;
    }


    filters.forEach((button) => {

      button.addEventListener("click", () => {

        const filter =
          button.dataset.archiveFilter;


        filters.forEach((item) => {

          const active =
            item === button;

          item.classList.toggle(
            "is-active",
            active
          );

          item.setAttribute(
            "aria-pressed",
            active
              ? "true"
              : "false"
          );

        });


        items.forEach((item) => {

          const category =
            item.dataset.archiveCategory;

          item.hidden =
            filter !== "all" &&
            category !== filter;

        });

      });

    });

  })();
</script>
