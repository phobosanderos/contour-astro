---
import c from "../content.json";
---

<a class="skip-note" href="#main">{c.header.a_1}</a>

<header class="site-header wrap">
  <a class="brand" href="#main" aria-label={`${c.site.title}, back to top`}>
    <span class="brand__name note note--int" set:html={c.header.span_5_html}></span>
  </a>
  <nav class="nav" aria-label="Main Navigation">
    <ul>
      <li><a class="nav__link" href="#work"><span class="nav__note" aria-hidden="true">{c.header.span_6}</span><span class="nav__label" data-label="Work">{c.header.span_7}</span></a></li>
      <li><a class="nav__link" href="#services"><span class="nav__note" aria-hidden="true">{c.header.span_8}</span><span class="nav__label" data-label="Services">{c.header.span_9}</span></a></li>
      <li><a class="nav__link" href="#process"><span class="nav__note" aria-hidden="true">{c.header.span_10}</span><span class="nav__label" data-label="Process">{c.header.span_11}</span></a></li>
      <li><a class="nav__link" href="#notes"><span class="nav__note" aria-hidden="true">{c.header.span_12}</span><span class="nav__label" data-label="Notes">{c.header.span_13}</span></a></li>
    </ul>
  </nav>
  <div class="tools">
    <button class="tool" type="button" data-action="theme" aria-label="Toggle light / dark theme"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.25"/><path d="M10 2.75V.25 M10 19.75v-2.5 M2.75 10H.25 M19.75 10h-2.5 M4.87 4.87L3.1 3.1 M16.9 16.9l-1.77-1.77 M4.87 15.13l-1.77 1.77 M16.9 3.1l-1.77 1.77" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button>
    <button class="tool" type="button" data-action="accent"><span class="swatch" aria-hidden="true"></span></button>
    <button class="tool tool--kbd note" type="button" data-action="palette" aria-label="Open command palette (Ctrl K)">{c.header.button_14}</button>
    <button class="tool tool--menu note" type="button" data-action="palette" aria-label="Open menu">{c.header.button_15}</button>
    <a class="btn header-cta" href="#contact">{c.header.a_16}</a>
  </div>
  <div class="hd-rule" aria-hidden="true"><span class="hd-rule__fill"></span><span class="hd-rule__tag note"></span></div>
</header>
