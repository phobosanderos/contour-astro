
---
import c from "../content.json";
---

<section class="section wrap cta" id="contact" aria-labelledby="c-h">
  <header class="section-head">
    <span class="note note--ink">{c.contact.span_1}</span>
  </header>

  <div class="cta__intro grid-12">
    <div class="cta__intro-copy">
      <h2 class="display cta__title" id="c-h">
      Tell me what<br />you want to make.
      </h2>

    </div>

    <div class="cta__stack">
      <div class="cta__stack-inner">
        <div class="cta__actions">
          <button
            class="btn cta__button cta__toggle"
            type="button"
            aria-expanded="false"
            aria-controls="brief-panel"
            data-brief-toggle
          >
            <span>Send a short brief</span>
            <span class="arrow cta__button-icon" aria-hidden="true"><span class="cta__arrow">↘</span></span>
          </button>

          <a
            class="btn btn--ghost cta__button cta__button--outline"
            href="https://cal.com/phobosanderos"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>Book a call</span>
            <span class="arrow cta__button-icon" aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="cta__email">
          <span class="note note--ink">EMAIL</span>
          <a class="link cta__email-link" href="mailto:phobosanderos@gmail.com">phobosanderos@gmail.com</a>
        </div>
      </div>
    </div>

    <div class="cta__expanded" id="brief-panel" hidden>
    <div class="cta__form-area">
      <form
  class="fg"
  action="https://api.web3forms.com/submit"
  method="POST"
  novalidate
>
  <input
    type="hidden"
    name="access_key"
    value="41b9b510-e46f-4f27-b67c-0b87c116f335"
  />

  <input
    type="checkbox"
    name="botcheck"
    style="display:none"
  />

  <input
    type="hidden"
    name="subject"
    value="New project brief"
  >

        <div class="fg-fields">
          <div class="fld">
            <label class="note" for="brief-name">{c.contact.span_8}</label>
            <input
              id="brief-name"
              name="name"
              type="text"
              aria-describedby="brief-name-error"
              autocomplete="name"
              required
            >
            <p class="fg-field-error note" id="brief-name-error" hidden></p>
          </div>

          <div class="fld">
            <label class="note" for="brief-email">{c.contact.span_9}</label>
            <input
              id="brief-email"
              name="email"
              type="email"
              aria-describedby="brief-email-error"
              autocomplete="email"
              required
            >
            <p class="fg-field-error note" id="brief-email-error" hidden></p>
          </div>

          <div class="fld">
            <label class="note" for="brief-company">{c.contact.span_10}</label>
            <input
              id="brief-company"
              name="company"
              type="text"
              aria-describedby="brief-company-error"
              autocomplete="organization"
            >
            <p class="fg-field-error note" id="brief-company-error" hidden></p>
          </div>

          <div class="fld">
            <label class="note" for="brief-budget">{c.contact.span_11}</label>
            <select id="brief-budget"
              name="budget"
              aria-describedby="brief-budget-error"
              required>
              <option value="" disabled selected hidden>Select a range</option>
              <option value={c.contact.option_12}>{c.contact.option_12}</option>
              <option value={c.contact.option_13}>{c.contact.option_13}</option>
              <option value={c.contact.option_14}>{c.contact.option_14}</option>
              <option value={c.contact.option_15}>{c.contact.option_15}</option>
              <option value={c.contact.option_16}>{c.contact.option_16}</option>
            </select>
            <p class="fg-field-error note" id="brief-budget-error" hidden></p>
          </div>

          <div class="fld fld-wide">
            <label class="note" for="brief-message">{c.contact.span_17}</label>
            <textarea
            id="brief-message"
              name="message"
              aria-describedby="brief-message-error"
            rows="4"
            required
            
            ></textarea>
            <p class="fg-field-error note" id="brief-message-error" hidden></p>
          </div>

          <div class="fld-wide fg-row">
            <button class="btn cta__button" type="submit">
              <span data-label>{c.contact.span_18}</span>
              <span class="arrow cta__button-icon" aria-hidden="true">↗</span>
            </button>
            <p class="fg-consent note">Your details are used only to reply to your message. <a class="link link--inline" href="/privacy/">Privacy</a></p>

            <p
              class="fg-status"
              data-status
              aria-live="polite"
              hidden
            ></p>
            <a class="link fg-fallback" data-form-fallback href="mailto:phobosanderos@gmail.com" hidden>Email phobosanderos@gmail.com instead</a>
          </div>
        </div>

        <div class="fg-sent" tabindex="-1" aria-live="polite" hidden>
          <p
            class="fg-sent-h h3"
          >{c.contact.p_19_html}</p>

          <button
            class="btn btn--ghost cta__button cta__button--outline"
            type="button"
            data-again
          >
            {c.contact.button_21}
          </button>
        </div>
      </form>
    </div>
    </div>
  </div>
</section>

<script>
// Keep homepage and cross-page #contact links clear of the fixed header.
const contactAnchor = document.querySelector("#contact");
const header = document.querySelector(".site-header");
const contactToggle = document.querySelector("[data-brief-toggle]");
const contactPanel = document.querySelector("#brief-panel");

function focusContactControl() {
  const open = contactPanel && !contactPanel.hidden;
  const success = open && contactPanel.querySelector("form.fg.is-sent");
  const destination = success
    ? contactPanel.querySelector("[data-again]")
    : open
      ? contactPanel.querySelector('input[name="name"]')
      : contactToggle;
  destination?.focus({ preventScroll: true });
}

function navigateToContact(updateHash = false) {
  if (!contactAnchor) return;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const offset = (header?.getBoundingClientRect().height || 72) + 12;
  if (updateHash && location.hash !== "#contact") {
    history.pushState(history.state, "", "#contact");
  }
  // Use a numeric target: Lenis otherwise subtracts scroll-margin and
  // scroll-padding in addition to its own offset.
  const top = Math.max(0, contactAnchor.getBoundingClientRect().top + scrollY - offset);
  if (window.__lenis && !reduced) {
    window.__lenis.scrollTo(top, {
      duration: .9,
      onComplete: focusContactControl
    });
    return;
  }
  if (reduced) {
    window.scrollTo({ top, behavior: "auto" });
    focusContactControl();
    return;
  }
  let finished = false;
  const finish = () => {
    if (finished) return;
    finished = true;
    window.removeEventListener("scrollend", finish);
    focusContactControl();
  };
  window.addEventListener("scrollend", finish, { once: true });
  window.scrollTo({ top, behavior: "smooth" });
  setTimeout(finish, 1200);
}

// Capture before the shared smooth-scroll listener to avoid competing scrolls.
window.addEventListener("click", (event) => {
  const link = event.target instanceof Element
    ? event.target.closest('a[href="#contact"], a[href="/#contact"]')
    : null;
  if (!link || event.defaultPrevented || event.button !== 0 ||
      event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
  event.preventDefault();
  event.stopPropagation();
  navigateToContact(true);
}, true);

window.addEventListener("hashchange", () => {
  if (location.hash === "#contact") navigateToContact();
});
window.addEventListener("load", () => {
  if (location.hash === "#contact") requestAnimationFrame(() => navigateToContact());
});

  // Brief disclosure: height/opacity animation with the form kept in the left grid column.
  const contactSection = document.querySelector("#contact");
  const briefToggle = document.querySelector("[data-brief-toggle]");
  const briefPanel = document.querySelector("#brief-panel");

  if (
    contactSection instanceof HTMLElement &&
    briefToggle instanceof HTMLButtonElement &&
    briefPanel instanceof HTMLElement
  ) {
    const form = briefPanel.querySelector("form.fg");
    const formArea = briefPanel.querySelector(".cta__form-area");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let activeAnimation = null;
    let lastFormHeight = 0;

    const motionDuration = () => {
      const raw = getComputedStyle(document.documentElement)
        .getPropertyValue("--dur-2").trim();
      const value = Number.parseFloat(raw);
      return Number.isFinite(value)
        ? value * (raw.endsWith("ms") ? 1 : 1000)
        : 800;
    };
    const motionEase = () =>
      getComputedStyle(document.documentElement)
        .getPropertyValue("--ease-out").trim() || "ease-out";

    const resetPanelStyles = () => {
      briefPanel.style.height = "";
      briefPanel.style.opacity = "";
      briefPanel.style.overflow = "";
    };

    function scrollToForm() {
      if (briefPanel.hidden) return;
      const headerHeight = document.querySelector(".site-header")
        ?.getBoundingClientRect().height || 72;
      const gap = Number.parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue("--gutter")
      ) || 16;
      const top = Math.max(0, briefPanel.getBoundingClientRect().top + window.scrollY - headerHeight - gap);
      if (!reducedMotion.matches && window.__lenis) {
        window.__lenis.scrollTo(top, { duration: .8 });
      } else {
        window.scrollTo({
          top,
          behavior: reducedMotion.matches ? "auto" : "smooth"
        });
      }
    }

    // Capture the fully laid-out form before Web3Forms replaces it with success.
    if (form instanceof HTMLFormElement && formArea instanceof HTMLElement) {
      form.addEventListener("submit", () => {
        if (!form.classList.contains("is-sent")) {
          const measured = form.getBoundingClientRect().height;
          if (measured > 0) lastFormHeight = measured;
        }
      }, true);

      new MutationObserver(() => {
        if (form.classList.contains("is-sent") && lastFormHeight > 0) {
          formArea.style.minHeight = lastFormHeight + "px";
        }
        // Keep the same minimum while the Send another control resets the fields.
      }).observe(form, { attributes: true, attributeFilter: ["class"] });
    }

    briefToggle.addEventListener("click", () => {
      const nextOpen = briefToggle.getAttribute("aria-expanded") !== "true";
      briefToggle.setAttribute("aria-expanded", String(nextOpen));
      contactSection.classList.toggle("is-brief-open", nextOpen);

      if (activeAnimation) {
        activeAnimation.cancel();
        activeAnimation = null;
      }

      if (nextOpen) {
        briefPanel.hidden = false;
        if (reducedMotion.matches) {
          resetPanelStyles();
          requestAnimationFrame(scrollToForm);
          return;
        }

        briefPanel.style.overflow = "hidden";
        briefPanel.style.height = "0px";
        briefPanel.style.opacity = "0";
        const endHeight = briefPanel.scrollHeight;
        activeAnimation = briefPanel.animate(
          [
            { height: "0px", opacity: 0 },
            { height: endHeight + "px", opacity: 1 }
          ],
          { duration: motionDuration(), easing: motionEase() }
        );
        activeAnimation.onfinish = () => {
          activeAnimation = null;
          resetPanelStyles();
        };
        activeAnimation.oncancel = () => {
          activeAnimation = null;
        };
        requestAnimationFrame(scrollToForm);
      } else {
        briefToggle.focus({ preventScroll: true });
        if (reducedMotion.matches) {
          briefPanel.hidden = true;
          resetPanelStyles();
          return;
        }

        const startHeight = briefPanel.getBoundingClientRect().height;
        briefPanel.style.overflow = "hidden";
        briefPanel.style.height = startHeight + "px";
        briefPanel.style.opacity = "1";
        activeAnimation = briefPanel.animate(
          [
            { height: startHeight + "px", opacity: 1 },
            { height: "0px", opacity: 0 }
          ],
          { duration: motionDuration(), easing: motionEase() }
        );
        activeAnimation.onfinish = () => {
          activeAnimation = null;
          briefPanel.hidden = true;
          resetPanelStyles();
        };
        activeAnimation.oncancel = () => {
          activeAnimation = null;
        };
      }
    });
  }

</script>
