---
import Base from "../../layouts/Base.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import work from "../../content/work.json";

export function getStaticPaths() {
  return work.featured.map((project, index) => {
    const nextProject =
      work.featured[(index + 1) % work.featured.length];

    return {
      params: {
        slug: project.slug
      },

      props: {
        project,
        nextProject
      }
    };
  });
}

const { project, nextProject } = Astro.props;

const stripYear = (title = "") => {
  const parts = title.trim().split(" ");
  const lastPart = parts[parts.length - 1];

  const isYear =
    lastPart?.length === 4 &&
    !Number.isNaN(Number(lastPart));

  return isYear
    ? parts.slice(0, -1).join(" ")
    : title;
};

const displayTitle =
  stripYear(project.title);

const nextDisplayTitle =
  stripYear(nextProject.title);

const media = project.media || [];
const hasShowcaseFilters =
  project.slug === "achievers-2026";
const hasShowcaseDivider =
  project.slug === "unity-cup-2026" ||
  project.slug === "welcome-to-ldn-2025";
const showcaseFilters = [
  "all",
  "editorial",
  "print",
  "digital",
  "merch"
];
---

<Base
  title={`${displayTitle} · Phobos & Eros`}
  description={project.description}
>
  <SectionHeader />

  <main
    id="main"
    class="project-page"
    tabindex="-1"
  >
    <section class="project-intro wrap">

     <div class="project-intro__top">
  <a
    href="/#work"
    class="note project-back"
    data-cursor="back ←"
  >
    ← Back to Work
  </a>

  <span class="note project-intro__year">
    {project.year}
  </span>
</div>

      <h1 class="project-intro__title">
        {displayTitle}
      </h1>

      <p class="project-intro__description">
        {project.description}
      </p>

    </section>

<section class="project-showcase wrap">

  {
    hasShowcaseFilters && media.length > 0 && (
      <div
        class="project-filters"
        aria-label="Filter Achievers media"
      >
        {
          showcaseFilters.map((filter, index) => (
            <button
              class={`project-filter note${index === 0 ? " is-active" : ""}`}
              type="button"
              data-showcase-filter={filter}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              {filter}
            </button>
          ))
        }
      </div>
    )
  }
  {
  hasShowcaseDivider && media.length > 0 && (
    <div
      class="project-showcase__divider"
      aria-hidden="true"
    ></div>
  )
}
  {
    media.length ? (
      <div class="project-masonry">
        {
          media.map((item, index) => {
            const isGroup = item.type === "group";

            const preview =
              isGroup
                ? item.items?.[item.coverIndex ?? 0]
                : item;

            const itemCount =
              isGroup
                ? item.items?.length || 0
                : 1;

            return (
              <button
                class="project-media"
                type="button"
                data-media-index={index}
                data-media-category={item.category || "all"}
                data-cursor="view"
                aria-label={`Open ${item.title || `media ${index + 1}`}`}
              >

                <div class="project-media__visual">
                  {
                    preview?.type === "video" ? (
                      <video
                        class="project-media__asset"
                        src={preview.src}
                        muted
                        playsinline
                        preload="metadata"
                      />
                    ) : (
                      <img
                        class="project-media__asset"
                        src={preview?.src}
                        alt={preview?.alt || ""}
                        loading="lazy"
                        decoding="async"
                      />
                    )
                  }
                </div>

                <div class="project-media__meta">
                  <span class="note">
                    {item.title}
                  </span>

                  {
                    isGroup && (
                      <span class="note project-media__count">
                        {String(itemCount).padStart(2, "0")} items
                      </span>
                    )
                  }
                </div>

              </button>
            );
          })
        }
      </div>
    ) : (
      <div class="project-showcase__empty">
        <span class="note">
          Media coming soon.
        </span>
      </div>
    )
  }

</section>


    <section class="project-next wrap">

      <header class="section-head project-next__head">
        <span class="note note--ink">
          Next project
        </span>

        <span class="note">
          {nextProject.year}
        </span>
      </header>

      <a
        href={`/work/${nextProject.slug}/`}
        class="project-next__link"
        data-cursor="open →"
      >
        <span class="project-next__title">
          {nextDisplayTitle}
        </span>

        <span
          class="project-next__arrow"
          aria-hidden="true"
        >
          →
        </span>
      </a>

    </section>


<dialog
  class="project-lightbox"
  data-project-lightbox
  aria-label="Expanded project media"
>
  <div class="project-lightbox__window">

    <header class="project-lightbox__head">

      <div class="project-lightbox__identity note">
        <span data-lightbox-number>01</span>
        <span>/</span>
        <span data-lightbox-title></span>
      </div>

      <button
        class="info-dialog__close project-lightbox__close"
        type="button"
        data-lightbox-close
        aria-label="Close media viewer"
      >
        ×
      </button>

    </header>

    <div
      class="project-lightbox__media"
      data-lightbox-media
      tabindex="0"
    ></div>

    <footer
      class="project-lightbox__nav"
      data-lightbox-nav
      hidden
    >
      <button
        class="project-lightbox__nav-button note"
        type="button"
        data-lightbox-prev
        data-cursor="previous"
        hidden
      >
        ← Previous
      </button>

      <span
        class="project-lightbox__counter note"
        data-lightbox-counter
      ></span>

      <button
        class="project-lightbox__nav-button note"
        type="button"
        data-lightbox-next
        data-cursor="next"
      >
        Next →
      </button>
    </footer>

  </div>
</dialog>

  </main>

<script
  is:inline
  define:vars={{ media }}
>
  (() => {

    const lightbox =
      document.querySelector("[data-project-lightbox]");

    const lightboxMedia =
      document.querySelector("[data-lightbox-media]");

    const lightboxNumber =
      document.querySelector("[data-lightbox-number]");

    const lightboxTitle =
      document.querySelector("[data-lightbox-title]");

    const lightboxNav =
      document.querySelector("[data-lightbox-nav]");

    const lightboxCounter =
      document.querySelector("[data-lightbox-counter]");

    const prevButton =
      document.querySelector("[data-lightbox-prev]");

    const nextButton =
      document.querySelector("[data-lightbox-next]");

    const triggers =
      document.querySelectorAll("[data-media-index]");

    const filterButtons =
      document.querySelectorAll("[data-showcase-filter]");


    if (
      !(lightbox instanceof HTMLDialogElement) ||
      !lightboxMedia
    ) return;


    let lastTrigger = null;
    let activeItems = [];
    let activeItemIndex = 0;


    /* ---------------------------------------------
       FILTERS
       --------------------------------------------- */

    filterButtons.forEach((button) => {

      button.addEventListener("click", () => {

        const filter =
          button.dataset.showcaseFilter;


        filterButtons.forEach((item) => {

          const active =
            item === button;

          item.classList.toggle(
            "is-active",
            active
          );

          item.setAttribute(
            "aria-pressed",
            active ? "true" : "false"
          );

        });


        triggers.forEach((trigger) => {

          const category =
            trigger.dataset.mediaCategory;

          const show =
            filter === "all" ||
            category === filter;

          trigger.hidden = !show;

        });

      });

    });


    /* ---------------------------------------------
       BUILD MEDIA
       --------------------------------------------- */

    function createAsset(item) {

      let asset;


      if (item.type === "video") {

        asset =
          document.createElement("video");

        asset.src = item.src;
        asset.controls = true;
        asset.controlsList = "nodownload";
        asset.autoplay = true;
        asset.playsInline = true;

      } else {

        asset =
          document.createElement("img");

        asset.src = item.src;
        asset.alt = item.alt || "";

      }


      return asset;
    }
    /* ---------------------------------------------
       RENDER CURRENT ITEM
       --------------------------------------------- */
function renderLightboxItem() {

  const item =
    activeItems[activeItemIndex];

  if (!item) return;


  const lightboxWindow =
    lightbox.querySelector(
      ".project-lightbox__window"
    );


  const multiple =
    activeItems.length > 1;


  /* ---------------------------------------------
     UPDATE NAV
     --------------------------------------------- */

  if (lightboxCounter) {

    lightboxCounter.textContent =
      multiple
        ? `${String(activeItemIndex + 1).padStart(2, "0")} / ${String(activeItems.length).padStart(2, "0")}`
        : "";

  }


  if (lightboxNav) {
    lightboxNav.hidden = !multiple;
  }


  if (prevButton) {
    prevButton.hidden =
      !multiple ||
      activeItemIndex === 0;
  }


  if (nextButton) {
    nextButton.hidden =
      !multiple ||
      activeItemIndex ===
        activeItems.length - 1;
  }


  /* ---------------------------------------------
     CREATE NEXT ASSET OFF-DOM
     --------------------------------------------- */

  const nextAsset =
    createAsset(item);


  const swapAsset = () => {

    const naturalWidth =
      nextAsset.tagName === "VIDEO"
        ? nextAsset.videoWidth
        : nextAsset.naturalWidth;

    const naturalHeight =
      nextAsset.tagName === "VIDEO"
        ? nextAsset.videoHeight
        : nextAsset.naturalHeight;


    if (!naturalWidth || !naturalHeight) {
      return;
    }


    const ratio =
      naturalWidth / naturalHeight;


    const head =
      lightbox.querySelector(
        ".project-lightbox__head"
      );

    const nav =
      lightbox.querySelector(
        ".project-lightbox__nav"
      );


    const headHeight =
      head?.offsetHeight || 0;

    const navHeight =
      nav && !nav.hidden
        ? nav.offsetHeight
        : 0;


    const horizontalPadding = 32;
    const verticalPadding = 32;
    const outerGap = 32;


    const maxAssetWidth =
      Math.max(
        240,
        window.innerWidth -
          horizontalPadding -
          outerGap
      );


    const maxAssetHeight =
      Math.max(
        240,
        window.innerHeight -
          headHeight -
          navHeight -
          verticalPadding -
          outerGap
      );


    let renderedWidth =
      Math.min(
        naturalWidth,
        maxAssetWidth
      );


    let renderedHeight =
      renderedWidth / ratio;


    if (renderedHeight > maxAssetHeight) {

      renderedHeight =
        maxAssetHeight;

      renderedWidth =
        renderedHeight * ratio;

    }


    nextAsset.style.width =
      `${Math.floor(renderedWidth)}px`;

    nextAsset.style.height =
      `${Math.floor(renderedHeight)}px`;


    /*
      Fade current media first.
      Crucially, we do NOT clear the old media yet.
    */

    lightboxMedia.classList.add(
      "is-switching"
    );


    window.setTimeout(() => {

      /*
        Resize while the old asset is faded.
      */

      if (lightboxWindow) {

        lightboxWindow.style.width =
          `${Math.ceil(
            renderedWidth +
            horizontalPadding
          )}px`;

      }


      /*
        Now swap content.
      */

      lightboxMedia.innerHTML = "";

      lightboxMedia.appendChild(
        nextAsset
      );


      /*
        Force the new asset to begin hidden.
      */

      nextAsset.style.opacity = "0";


      requestAnimationFrame(() => {

        lightboxMedia.classList.remove(
          "is-switching"
        );

        requestAnimationFrame(() => {

          nextAsset.style.opacity = "1";

        });

      });


      lightboxMedia.scrollTop = 0;
      lightboxMedia.scrollLeft = 0;

    }, 150);

  };


  /* ---------------------------------------------
     WAIT UNTIL NEXT ASSET IS READY
     --------------------------------------------- */

  if (nextAsset.tagName === "VIDEO") {

    if (nextAsset.readyState >= 1) {

      swapAsset();

    } else {

      nextAsset.addEventListener(
        "loadedmetadata",
        swapAsset,
        { once:true }
      );

    }

  } else {

    if (nextAsset.complete) {

      swapAsset();

    } else {

      nextAsset.addEventListener(
        "load",
        swapAsset,
        { once:true }
      );

    }

  }

}
function preloadNearbyItems() {

  const indexes = [
    activeItemIndex - 1,
    activeItemIndex + 1
  ];


  indexes.forEach((index) => {

    const item =
      activeItems[index];

    if (!item) return;


    if (item.type === "video") {

      const video =
        document.createElement("video");

      video.preload = "metadata";
      video.src = item.src;

    } else {

      const image =
        new Image();

      image.src = item.src;

    }

  });

}
    /* ---------------------------------------------
       OPEN
       --------------------------------------------- */

    function openLightbox(index, trigger) {

      const entry =
        media[index];

      if (!entry) return;


      activeItemIndex = 0;

      activeItems =
        entry.type === "group"
          ? entry.items || []
          : [entry];


      if (!activeItems.length) return;


      lastTrigger = trigger;


      /*
        Header:
        NUMBER / TITLE

        No category name.
      */

      if (lightboxNumber) {

        lightboxNumber.textContent =
          String(index + 1).padStart(2, "0");

      }


      if (lightboxTitle) {

        lightboxTitle.textContent =
          entry.title || "";

      }


      renderLightboxItem();


      /*
        Stop smooth page scrolling before
        opening the top-layer dialog.
      */

      if (window.__lenis) {
        window.__lenis.stop();
      }


      lightbox.showModal();

      requestAnimationFrame(() => {

        lightboxMedia.focus({
          preventScroll:true
        });

      });

    }


    /* ---------------------------------------------
       CLOSE
       --------------------------------------------- */

    function closeLightbox() {

      if (lightbox.open) {
        lightbox.close();
      }

    }


    /* ---------------------------------------------
       GROUP NAVIGATION
       --------------------------------------------- */

    function nextItem() {

      if (
        activeItems.length <= 1 ||
        activeItemIndex >=
          activeItems.length - 1
      ) return;


      activeItemIndex += 1;

      renderLightboxItem();

    }


    function previousItem() {

      if (
        activeItems.length <= 1 ||
        activeItemIndex <= 0
      ) return;


      activeItemIndex -= 1;

      renderLightboxItem();

    }


    /* ---------------------------------------------
       OPEN TRIGGERS
       --------------------------------------------- */

    triggers.forEach((trigger) => {

      trigger.addEventListener(
        "click",
        () => {

          openLightbox(
            Number(trigger.dataset.mediaIndex),
            trigger
          );

        }
      );

    });


    /* ---------------------------------------------
       CLOSE BUTTON
       --------------------------------------------- */

    document
      .querySelectorAll("[data-lightbox-close]")
      .forEach((button) => {

        button.addEventListener(
          "click",
          closeLightbox
        );

      });


    /* ---------------------------------------------
       PREVIOUS / NEXT
       --------------------------------------------- */

    prevButton?.addEventListener(
      "click",
      previousItem
    );

    nextButton?.addEventListener(
      "click",
      nextItem
    );


    /* ---------------------------------------------
       WHEEL
       --------------------------------------------- */

    lightbox.addEventListener(
      "wheel",
      (event) => {

        /*
          Prevent Lenis/page listeners from
          receiving wheel input while open.

          The .project-lightbox__media element
          remains normally scrollable.
        */

        event.stopPropagation();

      },
      { passive:true }
    );


    /* ---------------------------------------------
       CLICK OUTSIDE WINDOW
       --------------------------------------------- */

    lightbox.addEventListener(
      "click",
      (event) => {

        if (event.target === lightbox) {
          closeLightbox();
        }

      }
    );


    /* ---------------------------------------------
       NATIVE DIALOG CLOSE CLEANUP
       --------------------------------------------- */

    lightbox.addEventListener(
      "close",
      () => {

        lightboxMedia.innerHTML = "";

        activeItems = [];
        activeItemIndex = 0;

        if (window.__lenis) {
          window.__lenis.start();
        }


        if (lastTrigger) {

          lastTrigger.focus({
            preventScroll:true
          });

        }

      }
    );


    /* ---------------------------------------------
       KEYBOARD
       --------------------------------------------- */

    document.addEventListener(
      "keydown",
      (event) => {

        if (!lightbox.open) return;


        if (event.key === "Escape") {

          /*
            Prevent the browser's default dialog
            close so all cleanup goes through
            closeLightbox()/close event.
          */

          event.preventDefault();

          closeLightbox();

        }


        if (event.key === "ArrowRight") {
          nextItem();
        }


        if (event.key === "ArrowLeft") {
          previousItem();
        }

      }
    );

  })();
</script>
</Base>
