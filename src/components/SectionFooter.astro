---
import c from "../content.json";
---

<footer class="site-footer wrap" data-reveal="up">
  <div class="ft-banner text-font-bold" data-reveal="up">
    <p>{c.footer.p_1_html}</p>
  </div>
  <div class="ft-grid" data-reveal="up">
    <div class="ft-col ft-col--brand">
      <span class="ft-logo text-font-bold" aria-hidden="true">{c.site.title}</span>
    </div>
    <div class="ft-col">
      <span class="ft-label note">{c.footer.span_2}</span>
      <nav class="ft-nav" aria-label="Footer Site Links">
        <ul>
          <li><a class="ft-nav__link note note--int link link--secondary" href="#work">{c.footer.a_3}</a></li>
          <li><a class="ft-nav__link note note--int link link--secondary" href="#services">{c.footer.a_4}</a></li>
          <li><a class="ft-nav__link note note--int link link--secondary" href="#process">{c.footer.a_5}</a></li>
          <li><a class="ft-nav__link note note--int link link--secondary" href="#notes">{c.footer.a_6}</a></li>
        </ul>
      </nav>
    </div>
    <div class="ft-col">
      <span class="ft-label note">{c.footer.span_7}</span>
      <nav class="ft-nav" aria-label="Social Profiles">
        <ul>
          <li><a class="ft-nav__link note note--int link link--secondary" href="https://linkedin.com" target="_blank" rel="noopener">{c.footer.a_8}</a></li>
          <li><a class="ft-nav__link note note--int link link--secondary" href="https://instagram.com" target="_blank" rel="noopener">{c.footer.a_9}</a></li>
        </ul>
      </nav>
    </div>
    <div class="ft-col">
      <span class="ft-label note">{c.footer.span_10}</span>
      <nav class="ft-nav" aria-label="Contact Links">
        <ul>
          <li><a class="ft-nav__link note note--int link link--secondary" href="#contact">{c.footer.a_11}</a></li>
          <li><a class="ft-nav__link note note--int link link--secondary" href="mailto:phobosanderos@gmail.com">{c.footer.a_12}</a></li>
        </ul>
      </nav>
    </div>
  </div>
  <div class="ft-meta note" data-reveal="up">
    <div class="ft-meta__group">
      <p set:html={c.footer.p_13_html}></p>
      <div class="ft-meta__tools">
        <button class="ft-meta__tool" type="button" data-action="cookies">{c.footer.button_14} <span class="badge badge--int">0</span></button>
        <button class="ft-meta__tool" type="button" data-action="trackers">{c.footer.button_15} <span class="badge badge--int">0</span></button>
        <button class="ft-meta__tool" type="button" data-action="ads">{c.footer.button_16} <span class="badge badge--int">0</span></button>
      </div>
    </div>
    <div class="ft-meta__group">
      <span set:html={c.footer.span_17_html}></span>
      <nav class="ft-meta__nav" aria-label="Legal">
        <ul>
          <li><a class="link link--inline" href="#privacy">{c.footer.a_18}</a></li>
          <li><a class="link link--inline" href="#accessibility">{c.footer.a_19}</a></li>
        </ul>
      </nav>
    </div>
  </div>
</footer>
