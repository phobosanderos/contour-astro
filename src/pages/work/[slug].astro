---
import Base from "../../layouts/Base.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import work from "../../content/work.json";

export function getStaticPaths() {
  return work.featured.map((project, index) => {
    const nextProject =
      work.featured[(index + 1) % work.featured.length];

    return {
      params: {
        slug: project.slug
      },

      props: {
        project,
        nextProject
      }
    };
  });
}

const { project, nextProject } = Astro.props;

const displayTitle =
  project.title.replace(/\s+\d{4}$/, "");

const media = project.media || [];
---

<Base
  title={`${displayTitle} · Phobos & Eros`}
  description={project.description}
>
  <SectionHeader />

  <main
    id="main"
    class="project-page"
    tabindex="-1"
  >
    <section class="project-intro wrap">

      <div class="project-intro__back">
        <a
          href="/#work"
          class="note project-back"
          data-cursor="back ←"
        >
          ← Back to Work
        </a>
      </div>

      <div class="project-intro__meta">
        <span class="note">
          {project.category} · {project.type}
        </span>

        <span class="note">
          {project.year}
        </span>
      </div>

      <h1 class="project-intro__title">
        {displayTitle}
      </h1>

      <p class="project-intro__description">
        {project.description}
      </p>

    </section>


    <section class="project-showcase wrap">

      <header class="section-head project-showcase__head">
        <span class="note note--ink">
          Media showcase
        </span>

        <span aria-hidden="true"></span>
      </header>

      {
        media.length ? (
          <div class="project-masonry">
            {
              media.map((item, index) => (
                <button
                  class="project-media"
                  type="button"
                  data-media-index={index}
                  data-cursor="view"
                  aria-label={`Open media ${index + 1}`}
                >
                  {
                    item.type === "video" ? (
                      <video
                        class="project-media__asset"
                        src={item.src}
                        muted
                        playsinline
                        preload="metadata"
                      />
                    ) : (
                      <img
                        class="project-media__asset"
                        src={item.src}
                        alt={item.alt || ""}
                        loading="lazy"
                        decoding="async"
                      />
                    )
                  }
                </button>
              ))
            }
          </div>
        ) : (
          <div class="project-showcase__empty">
            <span class="note">
              Media coming soon.
            </span>
          </div>
        )
      }

    </section>


    <section class="project-next wrap">

      <header class="section-head project-next__head">
        <span class="note note--ink">
          Next project
        </span>

        <span class="note">
          {nextProject.year}
        </span>
      </header>

      <a
        href={`/work/${nextProject.slug}/`}
        class="project-next__link"
        data-cursor="open →"
      >
        <span class="project-next__title">
          {nextProject.title.replace(/\s+\d{4}$/, "")}
        </span>

        <span
          class="project-next__arrow"
          aria-hidden="true"
        >
          →
        </span>
      </a>

    </section>


    <div
      class="project-lightbox"
      data-project-lightbox
      hidden
      role="dialog"
      aria-modal="true"
      aria-label="Expanded project media"
    >
      <button
        class="project-lightbox__backdrop"
        type="button"
        data-lightbox-close
        aria-label="Close media viewer"
      ></button>

      <div class="project-lightbox__window">

        <button
          class="project-lightbox__close note"
          type="button"
          data-lightbox-close
          data-cursor="close"
        >
          Close ×
        </button>

        <div
          class="project-lightbox__media"
          data-lightbox-media
        ></div>

      </div>
    </div>

  </main>

  <script
    is:inline
    define:vars={{ media }}
  >
    (() => {
      const lightbox =
        document.querySelector("[data-project-lightbox]");

      const lightboxMedia =
        document.querySelector("[data-lightbox-media]");

      const triggers =
        document.querySelectorAll("[data-media-index]");

      if (!lightbox || !lightboxMedia) return;

      let lastTrigger = null;

      function closeLightbox() {
        lightbox.hidden = true;
        document.documentElement.classList.remove("project-lightbox-open");

        lightboxMedia.innerHTML = "";

        if (lastTrigger) {
          lastTrigger.focus({ preventScroll: true });
        }
      }

      function openLightbox(index, trigger) {
        const item = media[index];

        if (!item) return;

        lastTrigger = trigger;

        lightboxMedia.innerHTML = "";

        let asset;

        if (item.type === "video") {
          asset = document.createElement("video");
          asset.src = item.src;
          asset.controls = true;
          asset.autoplay = true;
          asset.playsInline = true;
        } else {
          asset = document.createElement("img");
          asset.src = item.src;
          asset.alt = item.alt || "";
        }

        lightboxMedia.appendChild(asset);

        lightbox.hidden = false;
        document.documentElement.classList.add("project-lightbox-open");
      }

      triggers.forEach((trigger) => {
        trigger.addEventListener("click", () => {
          openLightbox(
            Number(trigger.dataset.mediaIndex),
            trigger
          );
        });
      });

      document
        .querySelectorAll("[data-lightbox-close]")
        .forEach((button) => {
          button.addEventListener("click", closeLightbox);
        });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !lightbox.hidden) {
          closeLightbox();
        }
      });
    })();
  </script>

</Base>
