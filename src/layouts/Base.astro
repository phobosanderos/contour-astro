---
import c from "../content.json";
const buildStamp = Date.now();
---

<!doctype html>
<html lang={c.site.lang}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{c.site.title}</title>
    <meta name="description" content={c.site.description}>
    <link rel="icon" href="/img/favicon.svg">

    <script is:inline>
      try {
        const root = document.documentElement;
        root.classList.add("js");
        const savedTheme = localStorage.getItem("ct-theme");
        const savedAccent = localStorage.getItem("ct-accent");
        if (savedTheme) root.dataset.theme = savedTheme;
        if (savedAccent) root.dataset.accent = savedAccent;
      } catch (e) {}
    </script>

    <link rel="stylesheet" href={`/site.css?v=${buildStamp}`}>
  </head>
  <body>
    <slot />
    <script is:inline src={`/site.js?v=${buildStamp}`} defer></script>

    <script is:inline>
      window.addEventListener("load", () => {
        document.documentElement.dataset.preloaded = "true";
        const loader = document.querySelector(".preloader");
        if (loader) loader.remove();
      });
    </script>
  </body>
</html>
