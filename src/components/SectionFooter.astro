---
import c from "../content.json";
---

<style>
  .footer-claim {
    grid-column: 1 / span 6;
    max-width: 16ch;
    display: inline;
  }

  .book-call {
    display: inline;
    color: var(--accent-text);
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0 1px;
    transition: background-size 0.4s ease, color 0.2s ease;
  }

  .book-call:hover,
  .book-call:focus-visible {
    color: var(--accent-text);
    background-size: 100% 1px;
  }
</style>

<footer class="site-footer wrap">
  <div class="grid-12 footer-top">
    <p class="footer-claim h3">
      Have a project that needs to move?
      <a
        class="footer-cta-link"
        href="https://cal.com/phobosanderos"
        target="_blank"
        rel="noopener noreferrer"
      >
        Book a call.
      </a>
    </p>

    <div class="footer-col">
      <p class="note">Overview</p>
      <ul>
        <li><a class="link" href="#work">Work</a></li>
        <li><a class="link" href="#services">Services</a></li>
        <li><a class="link" href="#process">Process</a></li>
        <li><a class="link" href="https://www.inprnt.com/gallery/phobosanderos/" target="_blank" rel="noopener noreferrer">Shop ↗</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <p class="note">Elsewhere</p>
      <ul>
        <li><a class="link" href="https://www.linkedin.com/in/vipul-m-r/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></li>
        <li><a class="link" href="https://www.instagram.com/phobosanderos/" target="_blank" rel="noopener noreferrer">Instagram ↗</a></li>
        <li><a class="link" href="https://www.behance.net/phobosanderos" target="_blank" rel="noopener noreferrer">Behance ↗</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <p class="note">Contact</p>
      <ul>
        <li><a class="link" href="#contact">Send a brief</a></li>
        <li><a class="link" href="mailto:phobosanderos@gmail.com">Write an email</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom note">
    <p class="copy"><span>© Phobos and Eros</span><span>Designed and built by Vipul M.R</span></p>
    <nav class="legal-links" aria-label="Legal">
      <a class="link" href="/privacy/">Privacy</a>
    </nav>
  </div>
</footer>
