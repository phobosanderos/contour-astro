---
import c from "../content.json";
import "../styles.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = c.site.title, description = c.site.description } = Astro.props;
---

<!doctype html>
<html lang={c.site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      (function (d) {
        d.className = "js";
        d.dataset.accent = "blue";
        try {
          var theme = localStorage.getItem("ct-theme");
          var accent = localStorage.getItem("ct-accent");
          if (theme) d.dataset.theme = theme;
          if (accent) d.dataset.accent = accent;
        } catch (e) {}
      })(document.documentElement);
    </script>
  </head>
  <body class="is-loading" data-hero-generate="true">
    <div id="app" class="site-container">
      <div class="metawrap note note--meta" aria-hidden="true">
        <div class="meta-label meta-label--tl"><span>{c.header.span_2}</span></div>
        <div class="meta-label meta-label--tr"><span>{c.header.span_3}</span></div>
        <div class="meta-label meta-label--bl"><span>{c.header.span_4}</span></div>
        <div class="meta-label meta-label--br"><span><span class="preloader__count"></span></span></div>
      </div>
      <slot />
    </div>
    <script>
      import "../scripts.js";
    </script>
  </body>
</html>
