            set:html={c.footer.a_10_html}
          ></a>
        </li>
      </ul>
    </div>

    <div class="footer-col">
      <p class="note">{c.footer.p_11}</p>
      <ul>
        <li><a class="link" href="#contact">{c.footer.a_12}</a></li>
        <li><a class="link" href="mailto:phobosanderos@gmail.com">{c.footer.a_13}</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom note">
  <p class="copy"><span>{c.footer.span_23}</span><span>{c.footer.span_24}</span></p>
  <nav class="legal-links" aria-label="Legal">
    <a class="link" href="/privacy/">{c.footer.a_26}</a>
  </nav>
</div>
</footer>
