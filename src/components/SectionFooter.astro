---
import c from "../content.json";
---

<style>
  .footer-claim-wrap {
    grid-column: 1 / span 6;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .footer-claim {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.8rem;
    max-width: 22ch;
    line-height: 1.08;
  }

  .book-call {
    display: inline-flex;
    align-items: center;
    gap: 0.15em;
    color: inherit;
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0 1px;
    transition: background-size 0.4s ease, color 0.2s ease;
  }

  .book-call:hover,
  .book-call:focus-visible {
    color: var(--accent-text);
    background-size: 100% 1px;
  }

  .book-call .arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .book-call:hover .arrow,
  .book-call:focus-visible .arrow {
    transform: translateX(2px);
  }
</style>

<footer class="site-footer wrap">
  <div class="grid-12 footer-top">
    <div class="footer-claim-wrap">
     <p class="footer-claim h3">
  Have a project that needs to move?
  <a
    class="book-call"
    href="https://cal.com/phobosanderos"
    target="_blank"
    rel="noopener noreferrer"
  >
    Book a call.
  </a>
</p>
    </div>

    <div class="footer-col">
      <p class="note">{c.footer.p_6}</p>
      <ul>
        <li><a class="link" href="#work">{c.footer.a_3}</a></li>
        <li><a class="link" href="#services">{c.footer.a_4}</a></li>
        <li><a class="link" href="#process">{c.footer.a_5}</a></li>
        <li>
          <a
            class="link"
            href="https://www.inprnt.com/gallery/phobosanderos/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Shop ↗
          </a>
        </li>
      </ul>
    </div>

    <div class="footer-col">
      <p class="note">{c.footer.p_7}</p>
      <ul>
        <li>
          <a
            class="link"
            href="https://www.linkedin.com/in/vipul-m-r/"
            target="_blank"
            rel="noopener noreferrer"
            set:html={c.footer.a_8_html}
          ></a>
        </li>
        <li>
          <a
            class="link"
            href="https://www.instagram.com/phobosanderos/"
            target="_blank"
            rel="noopener noreferrer"
            set:html={c.footer.a_9_html}
