---
import Base from "../layouts/Base.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SectionWork from "../components/SectionWork.astro";
import SectionServices from "../components/SectionServices.astro";
import ServiceOverlays from "../components/ServiceOverlays.astro";
import SectionContact from "../components/SectionContact.astro";
import SectionFooter from "../components/SectionFooter.astro";
---

<Base homepage>
  <SectionHeader home />
  <main id="main" tabindex="-1">
    <section class="section wrap about" aria-labelledby="about-heading">
      <header class="section-head about__head">
        <h2 class="note note--ink" id="about-heading">ABOUT</h2>
      </header>

      <div class="about__copy">
        <div class="about__mark" aria-hidden="true" data-about-mark>
          <div class="about__mark-float">
            <div class="about__mark-rotor">
              {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((layer) => (
                <div class="about__mark-layer" style={`--depth:${(layer - 4) * 1.8}px;`}>
                  <img class="about__mark-icon about__mark-icon--light" src="/img/favicon-dark.svg" alt="" decoding="async" />
                  <img class="about__mark-icon about__mark-icon--dark" src="/img/favicon-light.svg" alt="" decoding="async" />
                </div>
              ))}
            </div>
          </div>
        </div>
        <p>Hi, I'm Vipul, a visual designer based in India. Thank you for taking the time to explore my work. It genuinely means a lot.</p>

        <p>I've always been fascinated by how things look and the emotions they evoke. Growing up, I often experienced life more as a spectator, which taught me to appreciate the little details. I think that's where my interest in design began.</p>

        <p>I've worked across campaigns, identities, editorial design, social content and motion. I enjoy experimenting across different mediums and hope to collaborate with people who aren't afraid to try something unconventional. There's still a lot I want to learn and create. I hope you enjoy my work.</p>
      </div>
    </section>
    <script is:inline>
      (function () {
        const copy = document.querySelector(".about__copy");
        const mark = document.querySelector("[data-about-mark]");
        if (!copy || !mark) return;
        const paragraphs = Array.from(copy.querySelectorAll("p"));
        if (!paragraphs.length) return;
        let frame = 0;
        const measure = () => {
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => {
            const copyWidth = copy.getBoundingClientRect().width;
            // Size against the complete About text: first line of the first
            // paragraph through the final line of the last paragraph.
            const first = paragraphs[0].getBoundingClientRect();
            const last = paragraphs[paragraphs.length - 1].getBoundingClientRect();
            const textHeight = Math.max(0, last.bottom - first.top);
            const mobile = window.matchMedia("(max-width: 767px)").matches;
            const available = copyWidth * (mobile ? 0.38 : 0.36);
            const size = Math.max(80, Math.min(textHeight, available, 460));
            const previous = parseFloat(mark.style.getPropertyValue("--about-mark-size")) || 0;
            if (Math.abs(previous - size) > 1) mark.style.setProperty("--about-mark-size", size + "px");
          });
        };
        measure();
        if ("ResizeObserver" in window) {
          const observer = new ResizeObserver(measure);
          observer.observe(copy);
        } else {
          window.addEventListener("resize", measure, { passive: true });
        }
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
      })();
    </script>
    <SectionWork />
    <SectionServices />
    <ServiceOverlays />
    <SectionContact />
    <SectionFooter />
  </main>
</Base>
