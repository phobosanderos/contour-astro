---
import c from "../content.json";
---

<footer class="site-footer wrap">
  <div class="grid-12 footer-top">
    <div class="footer-claim-wrap">
      <p class="footer-claim h3">
        Have a project that needs to move?
        <button class="cal-trigger" type="button" aria-expanded="false" aria-controls="calendar-drawer">
          Pick a time <span class="arrow" aria-hidden="true">→</span>
        </button>
      </p>

      <div id="calendar-drawer" class="calendar-drawer" aria-hidden="true">
        <div class="calendar-drawer__inner">
          <div id="cal-inline" class="cal-inline" aria-live="polite"></div>
        </div>
      </div>
    </div>

    <div class="footer-col">
      <p class="note">{c.footer.p_6}</p>
      <ul>
        <li><a class="link" href="#work">{c.footer.a_3}</a></li>
        <li><a class="link" href="#services">{c.footer.a_4}</a></li>
        <li><a class="link" href="#process">{c.footer.a_5}</a></li>
        <li>
          <a
            class="link"
            href="https://www.inprnt.com/gallery/phobosanderos/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Shop ↗
          </a>
        </li>
      </ul>
    </div>

    <div class="footer-col">
      <p class="note">{c.footer.p_7}</p>
      <ul>
        <li>
          <a
            class="link"
            href="https://www.linkedin.com/in/vipul-m-r/"
            target="_blank"
            rel="noopener noreferrer"
            set:html={c.footer.a_8_html}
          ></a>
        </li>
        <li>
          <a
            class="link"
            href="https://www.instagram.com/phobosanderos/"
            target="_blank"
            rel="noopener noreferrer"
            set:html={c.footer.a_9_html}
          ></a>
        </li>
        <li>
          <a
            class="link"
            href="https://www.behance.net/phobosanderos"
            target="_blank"
            rel="noopener noreferrer"
            set:html={c.footer.a_10_html}
          ></a>
        </li>
      </ul>
    </div>

    <div class="footer-col">
      <p class="note">{c.footer.p_11}</p>
      <ul>
        <li><a class="link" href="#contact">{c.footer.a_12}</a></li>
        <li><a class="link" href="mailto:phobosanderos@gmail.com">{c.footer.a_13}</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom note">
    <p class="copy"><span>{c.footer.span_23}</span><span>{c.footer.span_24}</span></p>
    <nav class="legal-links" aria-label="Legal">
      <a class="link" href="/privacy/">{c.footer.a_26}</a>
      <a class="link" href="#top">{c.footer.a_27}</a>
    </nav>
  </div>
</footer>

<script is:inline>
  (() => {
    const trigger = document.querySelector(".cal-trigger");
    const drawer = document.getElementById("calendar-drawer");
    const inlineEl = document.getElementById("cal-inline");
    if (!trigger || !drawer || !inlineEl) return;

    const root = document.documentElement;
    const calLink = "phobosanderos";
    let calLoaded = false;
    let calMounted = false;

    function currentTheme() {
      return root.dataset.theme === "dark" ? "dark" : "light";
    }

    function ensureCalScript(cb) {
      if (window.Cal) {
        cb();
        return;
      }

      const script = document.createElement("script");
      script.src = "https://cal.com/assets/external/widget.js";
      script.async = true;
      script.onload = cb;
      document.head.appendChild(script);
    }

    function mountCal() {
      if (!window.Cal) return;
      if (calMounted) {
        inlineEl.innerHTML = "";
      }

      const theme = currentTheme();
      window.Cal("inline", {
        elementOrSelector: "#cal-inline",
        calLink,
        config: {
          name: "Project enquiry",
          theme,
          layout: "month_view",
        },
      });

      calMounted = true;
      calLoaded = true;
    }

    function toggleDrawer() {
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      trigger.setAttribute("aria-expanded", String(!isOpen));
      drawer.classList.toggle("is-open", !isOpen);
      drawer.setAttribute("aria-hidden", String(isOpen));

      if (!isOpen) {
        ensureCalScript(mountCal);
      }
    }

    trigger.addEventListener("click", toggleDrawer);

    const themeObserver = new MutationObserver(() => {
      if (!drawer.classList.contains("is-open") || !window.Cal || !calMounted) return;
      inlineEl.innerHTML = "";
      window.Cal("inline", {
        elementOrSelector: "#cal-inline",
        calLink,
        config: {
          name: "Project enquiry",
          theme: currentTheme(),
          layout: "month_view",
        },
      });
    });

    themeObserver.observe(root, { attributes: true, attributeFilter: ["data-theme"] });
  })();
</script>
