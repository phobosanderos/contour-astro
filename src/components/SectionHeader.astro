---
import c from "../content.json";
const { home = false, currentSection = "" } = Astro.props;
---

<header class="site-header wrap">
  <div class="brand">
    {home ? (
      <>
        <span class="brand__name note note--int">{c.header.span_5_html}</span>
        <span class="brand__role note">| Visual design and motion.</span>
      </>
    ) : (
      <>
        <span class="brand__name note note--int" set:html={c.header.span_5_html}></span>
        <span class="brand__role note">| Visual design and motion.</span>
      </>
    )}
  </div>

  <nav class="nav" aria-label="Main Navigation">
  <ul>
    <li>
      <a class="nav__link" href="/#work" aria-current={currentSection === "work" ? "page" : undefined}>
        <span class="nav__label" data-label="Work">{c.header.span_6}</span>
      </a>
    </li>

    <li>
      <a class="nav__link" href="/#services">
        <span class="nav__label" data-label="Services">{c.header.span_8}</span>
      </a>
    </li>

    <li>
      <a
        class="nav__link"
        href="https://www.inprnt.com/gallery/phobosanderos/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="nav__label nav__label--prints">
          <span>{c.header.span_12}</span>
          <svg class="ui-icon nav__external-icon" aria-hidden="true" focusable="false"><use href="/img/ui-icons.svg#arrow-up-right"></use></svg>
        </span>
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    </li>
  </ul>
</nav>

  <div class="tools">
  <details class="mobile-nav" data-mobile-nav>
    <summary class="note" aria-label="Open navigation">Menu <svg class="ui-icon" aria-hidden="true" focusable="false"><use href="/img/ui-icons.svg#arrow-down"></use></svg></summary>
    <nav class="mobile-nav__panel" aria-label="Mobile navigation">
      <a href="/#work" aria-current={currentSection === "work" ? "page" : undefined}>Work</a>
      <a href="/#services">Services</a>
      <a href="https://www.inprnt.com/gallery/phobosanderos/" target="_blank" rel="noopener noreferrer">Prints <svg class="ui-icon" aria-hidden="true" focusable="false"><use href="/img/ui-icons.svg#arrow-up-right"></use></svg><span class="sr-only"> (opens in a new tab)</span></a>
      <a href="/#contact">Start a project</a>
    </nav>
  </details>
  <button class="tool tool--theme" type="button" data-action="theme" role="switch" aria-label="Dark mode" aria-checked="false" title="Switch to dark mode">
    <svg class="ui-icon theme-icon theme-icon--sun" aria-hidden="true" focusable="false"><use href="/img/ui-icons.svg#sun"></use></svg>
    <svg class="ui-icon theme-icon theme-icon--moon" aria-hidden="true" focusable="false"><use href="/img/ui-icons.svg#moon"></use></svg>
  </button>
  <a class="btn header-cta" href="/#contact">{c.header.a_16}</a>
</div>
</header>

<script>
  const mobileMenu = document.querySelector("[data-mobile-nav]");
  if (mobileMenu) {
    mobileMenu.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => { mobileMenu.open = false; });
    });
    mobileMenu.addEventListener("toggle", () => {
      mobileMenu.querySelector("summary")?.setAttribute("aria-label", mobileMenu.open ? "Close navigation" : "Open navigation");
    });
    document.addEventListener("click", event => {
      if (mobileMenu.open && !mobileMenu.contains(event.target)) mobileMenu.open = false;
    });
    document.addEventListener("keydown", event => {
      if (event.key !== "Escape" || !mobileMenu.open) return;
      mobileMenu.open = false;
      mobileMenu.querySelector("summary")?.focus({preventScroll:true});
    });
  }
</script>
