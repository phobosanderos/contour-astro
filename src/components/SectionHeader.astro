---
import c from "../content.json";
const { home = false, currentSection = "" } = Astro.props;
---

<header class="site-header wrap">
  <a class="brand" href="/#main" aria-label={`${c.site.title}, back to top`}>
    {home ? (
      <>
        <span class="brand__name note note--int">{c.header.span_5_html}</span>
        <span class="brand__role note">| Visual design and motion.</span>
      </>
    ) : (
      <>
        <span class="brand__name note note--int" set:html={c.header.span_5_html}></span>
        <span class="brand__role note">| Visual design and motion.</span>
      </>
    )}
  </a>

  <nav class="nav" aria-label="Main Navigation">
  <ul>
    <li>
      <a class="nav__link" href="/#work" aria-current={currentSection === "work" ? "page" : undefined}>
        <span class="nav__label" data-label="Work">{c.header.span_6}</span>
      </a>
    </li>

    <li>
      <a class="nav__link" href="/#services">
        <span class="nav__label" data-label="Services">{c.header.span_8}</span>
      </a>
    </li>

    <li>
      <a
        class="nav__link"
        href="https://www.inprnt.com/gallery/phobosanderos/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="nav__print-clip">
          <span class="nav__label nav__label--prints">
            <span class="nav__print-row">
              <span>{c.header.span_12}</span>
              <svg class="ui-icon nav__external-icon" aria-hidden="true" focusable="false"><use href="/img/ui-icons.svg#arrow-up-right"></use></svg>
            </span>
            <span class="nav__print-row nav__print-row--hover" aria-hidden="true">
              <span>{c.header.span_12}</span>
              <svg class="ui-icon nav__external-icon" focusable="false"><use href="/img/ui-icons.svg#arrow-up-right"></use></svg>
            </span>
          </span>
        </span>
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    </li>
  </ul>
</nav>

  <div class="tools">
  <button class="tool" type="button" data-action="theme" aria-label="Dark theme" aria-pressed="false"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.25"/><path d="M10 .2V2.75 M10 17.25V19.8 M.2 10H2.75 M17.25 10H19.8 M3.07 3.07L4.85 4.85 M15.15 15.15L16.93 16.93 M16.93 3.07L15.15 4.85 M4.85 15.15L3.07 16.93"></path></svg></button>
  <button class="tool" type="button" data-action="accent" aria-label="Cycle accent color (current: blue)"><span class="swatch" aria-hidden="true"></span></button>
  <a class="btn header-cta" href="/#contact">{c.header.a_16}</a>
</div>
</header>
