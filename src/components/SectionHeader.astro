---
import c from "../content.json";
---

<header class="header container" data-reveal="up">
  <div class="header__inner">
    <a href="#main" data-reveal="up" aria-label={`${c.site.title}, back to top`}>
      {/* Option 1: Dual Parallel Layout Lines Mark (Scaled & Static) */}
      <svg class="monogram brand__mark" style="transform: scale(2.2); transform-origin: left center; margin-right: 1.5rem;" viewBox="0 0 58 40" aria-hidden="true">
        <path d="M20 8 L20 32 M38 8 L38 32" stroke="currentColor" stroke-width="2.5" fill="none" />
        <circle class="monogram__dot" cx="44" cy="20" r="1.6"/>
      </svg>
    </a>

    <nav class="nav" aria-label="Main Navigation">
      <ul class="nav__list">
        <li><a class="nav__link link" href="#work">{c.header.a_1}</a></li>
        <li><a class="nav__link link" href="#services">{c.header.a_2}</a></li>
        <li><a class="nav__link link" href="#process">{c.header.a_3}</a></li>
        <li><a class="nav__link link" href="#notes">{c.header.a_4}</a></li>
      </ul>
    </nav>

    <div class="header__actions">
      <a class="btn btn--secondary" href="#contact" data-reveal="up">
        <span class="btn__meta">{c.header.span_5}</span>
        {c.header.a_6}
      </a>
    </div>
  </div>
</header>
