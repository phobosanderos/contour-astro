
---
import c from "../content.json";
const currentYear = new Date().getFullYear();
---

<footer class="site-footer wrap">
  <div class="grid-12 footer-top">
    <div class="footer-col footer-col--overview">
      <p class="note">{c.footer.p_6}</p>

      <nav aria-label="Overview"><ul>
        <li>
          <a class="link" href="/#work">{c.footer.a_3}</a>
        </li>
        <li>
          <a class="link" href="/#services">{c.footer.a_4}</a>
        </li>
        <li>
          <a
            class="link"
            href="https://www.inprnt.com/gallery/phobosanderos/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Prints<svg class="ui-icon" aria-hidden="true" focusable="false"><use href="/img/ui-icons.svg#arrow-up-right"></use></svg><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
      </ul>
    </nav></div>

    <div class="footer-col footer-col--elsewhere">
      <p class="note">{c.footer.p_7}</p>

      <nav aria-label="Elsewhere"><ul>
        <li>
          <a
            class="link"
            href="https://www.linkedin.com/in/vipul-m-r/"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn<svg class="ui-icon" aria-hidden="true" focusable="false"><use href="/img/ui-icons.svg#arrow-up-right"></use></svg><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
        <li>
          <a
            class="link"
            href="https://www.instagram.com/phobosanderos/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram<svg class="ui-icon" aria-hidden="true" focusable="false"><use href="/img/ui-icons.svg#arrow-up-right"></use></svg><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
        <li>
          <a
            class="link"
            href="https://www.behance.net/phobosanderos"
            target="_blank"
            rel="noopener noreferrer"
          >
            Behance<svg class="ui-icon" aria-hidden="true" focusable="false"><use href="/img/ui-icons.svg#arrow-up-right"></use></svg><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
      </ul></nav>
    </div>
  </div>

  <div class="footer-bottom note">
    <p class="copy">
      <span>© {currentYear} Phobos &amp; Eros</span>
      <span>{c.footer.span_24}</span>
    </p>

    <nav class="legal-links" aria-label="Legal">
      <a class="link" href="/?rates=terms#services">Rates and terms</a>
      <a class="link" href="/privacy/">{c.footer.a_26}</a>
    </nav>
  </div>
</footer>
