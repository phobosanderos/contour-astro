---
import Base from "../layouts/Base.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SectionWork from "../components/SectionWork.astro";
import SectionServices from "../components/SectionServices.astro";
import ServiceOverlays from "../components/ServiceOverlays.astro";
import SectionContact from "../components/SectionContact.astro";
import SectionFooter from "../components/SectionFooter.astro";
---

<Base homepage image="/img/og-home-v3.png" imageWidth={1200} imageHeight={530}>
  <SectionHeader home />
  <main id="main" tabindex="-1">
    <SectionWork />
    <SectionServices />
    <ServiceOverlays />
    <SectionContact />
    <SectionFooter />
  </main>
</Base>
