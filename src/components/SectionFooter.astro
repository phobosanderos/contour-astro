
---
import c from "../content.json";
const currentYear = new Date().getFullYear();
---

<footer class="site-footer wrap">
  <div class="grid-12 footer-top">
    <div class="footer-col footer-col--overview">
      <p class="note">{c.footer.p_6}</p>

      <nav aria-label="Overview">
        <ul>
        <li>
          <a class="link" href="/#work">{c.footer.a_3}</a>
        </li>
        <li>
          <a class="link" href="/#services">{c.footer.a_4}</a>
        </li>
        <li>
          <a
            class="link"
            href="https://www.inprnt.com/gallery/phobosanderos/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Prints<svg class="ui-icon" aria-hidden="true" focusable="false"><use href="/img/ui-icons.svg#arrow-up-right"></use></svg><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
        </ul>
      </nav>
    </div>

    <div class="footer-col footer-col--elsewhere">
      <p class="note">{c.footer.p_7}</p>

      <nav aria-label="Elsewhere">
        <ul>
        <li>
          <a
            class="link"
            href="https://www.linkedin.com/in/vipul-m-r/"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn<svg class="ui-icon" aria-hidden="true" focusable="false"><use href="/img/ui-icons.svg#arrow-up-right"></use></svg><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
        <li>
          <a
            class="link"
            href="https://www.instagram.com/phobosanderos/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram<svg class="ui-icon" aria-hidden="true" focusable="false"><use href="/img/ui-icons.svg#arrow-up-right"></use></svg><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
        <li>
          <a
            class="link"
            href="https://www.behance.net/phobosanderos"
            target="_blank"
            rel="noopener noreferrer"
          >
            Behance<svg class="ui-icon" aria-hidden="true" focusable="false"><use href="/img/ui-icons.svg#arrow-up-right"></use></svg><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
        </ul>
      </nav>
    </div>
  </div>

  <div class="footer-bottom note">
    <p class="copy">
      <span>© <span data-copyright-year>{currentYear}</span> Phobos &amp; Eros</span>
      <span>{c.footer.span_24}</span>
    </p>

    <nav class="legal-links" aria-label="Legal">
      <a class="link" href="/?rates=terms#services">Terms and conditions</a>
      <span class="legal-links__divider" aria-hidden="true">|</span>
      <a class="link" href="/privacy/">{c.footer.a_26}</a>
    </nav>
  </div>
</footer>

<script is:inline>
  document.querySelectorAll("[data-copyright-year]").forEach((year) => {
    year.textContent = String(new Date().getFullYear());
  });
  // Fit the copyright to the available mobile width without reducing it
  // unnecessarily on wider phones. Keep desktop typography CSS-controlled.
  const copyright = document.querySelector(".site-footer .copy");
  if (copyright) {
    const fitCopyright = () => {
      copyright.style.fontSize = "";
      if (!window.matchMedia("(max-width: 767px)").matches) return;
      const available = copyright.clientWidth;
      if (!available) return;
      let low = 9, high = 17;
      for (let i = 0; i < 12; i++) {
        const mid = (low + high) / 2;
        copyright.style.fontSize = mid + "px";
        // Use the true right edge of the text, not the width of the flex row.
        const pieces = copyright.querySelectorAll(":scope > span");
        const intrinsicWidth = Array.from(pieces).reduce(
          (sum, piece) => sum + piece.getBoundingClientRect().width, 0
        );
        if (intrinsicWidth <= available - 2) low = mid;
        else high = mid;
      }
      copyright.style.fontSize = low.toFixed(2) + "px";
    };
    fitCopyright();
    if ("ResizeObserver" in window) {
      new ResizeObserver(fitCopyright).observe(copyright.parentElement);
    } else window.addEventListener("resize", fitCopyright, { passive: true });
    document.fonts?.ready?.then(fitCopyright);
  }
</script>
