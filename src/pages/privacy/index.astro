---
import SectionFooter from "../../components/SectionFooter.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import ServiceOverlays from "../../components/ServiceOverlays.astro";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Privacy | Phobos &amp; Eros</title>
<meta name="description" content="How the contact form on this site uses your details.">
<meta name="robots" content="noindex">
<link rel="icon" type="image/svg+xml" href="/img/favicon-dark.svg" id="site-favicon">
<link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png">
<link rel="stylesheet" href="/site.css">
<script is:inline>
  (function () {
    const root = document.documentElement;

    try {
      const savedTheme = localStorage.getItem("ct-theme");
      const systemDark = window.matchMedia(
        "(prefers-color-scheme: dark)"
      ).matches;

      root.dataset.theme =
        savedTheme || (systemDark ? "dark" : "light");
      const accent = localStorage.getItem("ct-accent");
      root.dataset.accent = ["blue", "orange", "lime"].includes(accent) ? accent : "blue";
    } catch (error) {
      root.dataset.theme = "light";
    }
  })();
</script>
<style is:global>
body {
  min-height: 100vh;
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  transition:
    background-color var(--dur-2) var(--ease-out),
    color var(--dur-2) var(--ease-out);
}
.fg-legal{max-width:44rem;margin:0 auto;padding:clamp(1.5rem,6vw,5rem) 1.25rem 1.5rem;line-height:1.6}
.fg-legal h1{font-size:clamp(2.25rem,7vw,4rem);line-height:1.05;margin:1rem 0 2rem}
.fg-legal h2{font-size:1.25rem;line-height:1.3;margin:2.5rem 0 .5rem}
.fg-legal p,.fg-legal li{max-width:38rem;margin:0 0 1rem}
.fg-legal ul{padding-left:1.25rem}
.fg-legal a{color:inherit;text-decoration:underline;text-underline-offset:.15em}
.fg-legal .fg-legal__back{font-size:.875rem;opacity:1}
.fg-legal #privacy-back{color:var(--accent-text);text-decoration:none;background:linear-gradient(currentColor,currentColor) 0 100%/0 1px no-repeat;transition:background-size var(--dur-1) var(--ease-out);}
.fg-legal #privacy-back:hover{background-size:100% 1px}
</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<SectionHeader />
<script is:inline>
  (() => {
    const root = document.documentElement;
    const themeButton = document.querySelector('[data-action="theme"]');
    const accentButton = document.querySelector('[data-action="accent"]');
    const accents = ["blue", "orange", "lime"];
    function sync() {
      themeButton?.setAttribute("aria-label", root.dataset.theme === "dark" ? "Light mode" : "Dark mode");
      themeButton?.setAttribute("aria-pressed", String(root.dataset.theme === "dark"));
      accentButton?.setAttribute("aria-label", "Cycle accent color (current: " + (root.dataset.accent || "blue") + ")");
    }
    themeButton?.addEventListener("click", () => {
      root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
      try { localStorage.setItem("ct-theme", root.dataset.theme); } catch {}
      sync();
    });
    accentButton?.addEventListener("click", () => {
      root.dataset.accent = accents[(accents.indexOf(root.dataset.accent || "blue") + 1) % accents.length];
      try { localStorage.setItem("ct-accent", root.dataset.accent); } catch {}
      sync();
    });
    const favicon = document.getElementById("site-favicon");
    const updateFavicon = () => {
      if (favicon) favicon.href = root.dataset.theme === "dark"
        ? "/img/favicon-light.svg"
        : "/img/favicon-dark.svg";
    };
    const observer = new MutationObserver(updateFavicon);
    observer.observe(root, { attributes: true, attributeFilter: ["data-theme"] });
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener?.("change", updateFavicon);
    sync();
    updateFavicon();
  })();
</script>
<main class="fg-legal" id="main" tabindex="-1">
<p class="fg-legal__back">
  <a href="/" id="privacy-back" class="note project-back" data-cursor="back"><svg class="ui-icon" aria-hidden="true" focusable="false"><use href="/img/ui-icons.svg#arrow-left"></use></svg> Back to the home page</a>
</p>
<!-- Privacy wording requires legal review before publication as a final legal notice. -->
<h1>Privacy</h1>
<p>Last updated: 6 November 2026</p>
<p>I run this site under the name <strong>Phobos &amp; Eros</strong>. I am Vipul M.R, and I handle enquiries sent to me through its contact form. If you have any questions about your personal data, email <a href="mailto:phobosanderos@gmail.com">phobosanderos@gmail.com</a>.</p>
<h2>What I collect</h2>
<p>When you send a project brief, the form asks for your name, email address, budget range and brief, plus your studio or company (optional). You may also include personal information in the brief that I did not ask for.</p>
<p>Web3Forms and its sub-processors also process technical information, which may include your IP address, submission time and referrer, to deliver submissions, secure the service and filter spam. This is not limited to what you type in.</p>
<h2>Why I use it</h2>
<p>I use your enquiry to reply, discuss potential work and, where appropriate, communicate about a project. My proposed legal basis, where the GDPR or UK GDPR applies, is taking steps at your request before a contract and, where applicable, my legitimate interests in managing correspondence and protecting the form against spam. The appropriate basis needs legal review.</p>
<h2>Who processes it</h2>
<p>I use <a href="https://web3forms.com/" target="_blank" rel="noopener noreferrer">Web3Forms</a>, operated by Web3Creative, to deliver contact-form submissions to my email inbox. Web3Forms processes submission information on my behalf, including through its service providers. See its <a href="https://web3forms.com/privacy" target="_blank" rel="noopener noreferrer">privacy policy</a>, <a href="https://web3forms.com/dpa#annex-3--authorised-sub-processors" target="_blank" rel="noopener noreferrer">sub-processor list in Annex 3</a> and <a href="https://web3forms.com/dpa" target="_blank" rel="noopener noreferrer">data processing agreement</a>.</p>
<h2>How long I keep it</h2>
<p>I keep my own copy of correspondence for <strong>30 days</strong>. Web3Forms has a separate retention policy: it currently describes form submissions as retained for up to three years by default, subject to any shorter configured period or deletion. My 30-day period does not, by itself, change Web3Forms' retention settings.</p>
<h2>International transfers</h2>
<p>My providers may process personal data in countries outside your own. Web3Forms describes international transfers and safeguards, including standard contractual clauses for relevant UK and European transfers, in its <a href="https://web3forms.com/dpa">data processing agreement</a>. The legal adequacy of these arrangements for this site requires review.</p>
<h2>Your rights and requests</h2>
<p>Depending on the law that applies to you, you may request access, correction, deletion, restriction or objection regarding your personal data. Please contact <a href="mailto:phobosanderos@gmail.com">phobosanderos@gmail.com</a>. I aim to respond to rights requests within <strong>30 days</strong>, subject to any different mandatory legal deadline.</p>
<p>If you ask me to delete a submission, I will also request deletion of the copy processed by Web3Forms, subject to applicable legal requirements and Web3Forms' documented deletion process. I cannot guarantee that every provider backup disappears immediately.</p>
<h2>Complaints</h2>
<p>Depending on which law applies, you may be able to contact the <a href="https://ico.org.uk/make-a-complaint/">UK Information Commissioner's Office (ICO)</a>, the <a href="https://www.edpb.europa.eu/about-edpb/about-edpb/members_en">relevant EEA data protection authority</a>, or <a href="https://www.meity.gov.in/">India's Data Protection Board / MeitY</a>. The correct regulator and any complaint process depend on your circumstances.</p>
    <script is:inline>
  const backLink = document.querySelector("#privacy-back");

  backLink?.addEventListener("click", function (event) {
    event.preventDefault();

    try {
      sessionStorage.setItem("ct-return-to-bottom", "1");
    } catch (error) {}

    window.location.href = "/";
  });
</script>
</main>
<ServiceOverlays />
<SectionFooter />
</body>
</html>
